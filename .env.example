# Site
NEXT_PUBLIC_SITE_URL=https://www.example.com
REVALIDATE_SECRET=change-me-to-a-long-random-string

# PostgreSQL (required for Docker / production data layer)
DATABASE_URL=postgresql://glory:glory@localhost:5432/glory_tn

# Redis (optional locally; in-memory fallback used when unavailable)
REDIS_URL=redis://localhost:6379

# Data source: "file" (default for local builds without DB) | "db"
DATA_SOURCE=file

# Analytics (optional)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# Contact delivery (optional)
CONTACT_WEBHOOK_URL=
